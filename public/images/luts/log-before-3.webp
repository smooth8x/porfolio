
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 600" width="1000" height="600">
  <defs>
    <linearGradient id="lutGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#4B5358"/><stop offset="50%" stop-color="#353B40"/><stop offset="100%" stop-color="#282D31"/>
    </linearGradient>
    <filter id="gradeGlow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="30" result="blur"/>
      <feComposite in="SourceGraphic" in2="blur" operator="over"/>
    </filter>
  </defs>

  <!-- Base Canvas -->
  <rect width="1000" height="600" fill="url(#lutGrad)"/>

  
  <!-- Flat Log Overlay -->
  <rect width="1000" height="600" fill="rgba(255,255,255,0.08)"/>
  

  <!-- Subtle Film Lines & Horizon -->
  <line x1="80" y1="360" x2="920" y2="360" stroke="rgba(255,255,255,0.1)" stroke-width="1.5"/>

  <!-- Mountain Silhouette / Cinematic Scene -->
  <polygon points="80,500 240,320 380,420 560,260 740,400 920,300 920,540 80,540" 
    fill="rgba(255,255,255,0.12)" 
    stroke="rgba(255,255,255,0.15)" 
    stroke-width="2"/>

  <!-- Water Reflection / Floor Reflection -->
  <rect x="80" y="440" width="840" height="80" fill="rgba(255,255,255,0.06)"/>

  <!-- Status HUD -->
  <g transform="translate(60, 60)">
    <rect width="220" height="42" rx="8" fill="rgba(0,0,0,0.5)" stroke="#6A7580" stroke-width="1.5"/>
    <text x="110" y="26" fill="#88929A" font-family="monospace" font-size="14" font-weight="700" text-anchor="middle">
      FLAT LOG RAW
    </text>
  </g>

  <!-- Camera / Color space tag -->
  <text x="940" y="85" fill="#778899" font-family="monospace" font-size="13" text-anchor="end">
    Rec.709 → Standard Profile
  </text>
  
  <text x="60" y="550" fill="#88929A" font-family="system-ui, sans-serif" font-size="18" font-weight="600">
    Flat Raw Camera Profile (Unprocessed S-Log / Log)
  </text>
</svg>
