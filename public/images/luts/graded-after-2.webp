
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 600" width="1000" height="600">
  <defs>
    <linearGradient id="lutGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#18130B"/><stop offset="40%" stop-color="#0A0F1A"/><stop offset="100%" stop-color="#261705"/>
    </linearGradient>
    <filter id="gradeGlow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="30" result="blur"/>
      <feComposite in="SourceGraphic" in2="blur" operator="over"/>
    </filter>
  </defs>

  <!-- Base Canvas -->
  <rect width="1000" height="600" fill="url(#lutGrad)"/>

  
  <!-- Graded Golden Atmospheric Bloom -->
  <circle cx="650" cy="220" r="160" fill="#E5A93C" opacity="0.35" filter="url(#gradeGlow)"/>
  <circle cx="280" cy="420" r="140" fill="#0EA5E9" opacity="0.2" filter="url(#gradeGlow)"/>
  

  <!-- Subtle Film Lines & Horizon -->
  <line x1="80" y1="360" x2="920" y2="360" stroke="rgba(229,169,60,0.3)" stroke-width="1.5"/>

  <!-- Mountain Silhouette / Cinematic Scene -->
  <polygon points="80,500 240,320 380,420 560,260 740,400 920,300 920,540 80,540" 
    fill="#05070B" 
    stroke="rgba(229,169,60,0.4)" 
    stroke-width="2"/>

  <!-- Water Reflection / Floor Reflection -->
  <rect x="80" y="440" width="840" height="80" fill="rgba(229,169,60,0.08)"/>

  <!-- Status HUD -->
  <g transform="translate(60, 60)">
    <rect width="220" height="42" rx="8" fill="rgba(229,169,60,0.2)" stroke="#E5A93C" stroke-width="1.5"/>
    <text x="110" y="26" fill="#F4F4F6" font-family="monospace" font-size="14" font-weight="700" text-anchor="middle">
      GRADED 3D LUT
    </text>
  </g>

  <!-- Camera / Color space tag -->
  <text x="940" y="85" fill="#E5A93C" font-family="monospace" font-size="13" text-anchor="end">
    Apple Log → Graded Cyber Cyan
  </text>
  
  <text x="60" y="550" fill="#F4F4F6" font-family="system-ui, sans-serif" font-size="18" font-weight="600">
    Rich Cinematic Contrast • Precision Color Balancing
  </text>
</svg>
